{
  "expo": {
    "name": "Kuova",
    "slug": "app-tests-medicos",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "apptestsmedicos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kuovahealth.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Kuova uses the camera to photograph your lab reports and meals, and for your profile photo.",
        "NSPhotoLibraryUsageDescription": "Kuova opens your photos so you can choose a lab report, a meal or your profile photo.",
        "NSMicrophoneUsageDescription": "Kuova uses the microphone to record voice notes in your log, only when you tap record.",
        "NSPhotoLibraryAddUsageDescription": "Kuova only saves an image to your photos when you choose Save Image, for example a badge you want to share."
      }
    },
    "android": {
      "package": "com.astoramor.apptestsmedicos",
      "adaptiveIcon": {
        "backgroundColor": "#0E2A24",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_BODY_TEMPERATURE",
        "android.permission.health.READ_VO2_MAX",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_BLOOD_GLUCOSE",
        "android.permission.health.READ_RESPIRATORY_RATE"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E2A24",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 88
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": "Kuova uses the microphone to record voice notes in your log, only when you tap record.",
          "enableBackgroundPlayback": false
        }
      ],
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Kuova reads your activity, sleep, heart rate and heart rate variability from Health (and, if you have them, your weight, workouts, blood pressure, glucose, blood oxygen, temperature and breathing rate) to show them next to your lab results and your daily log. Kuova never writes to Health.",
          "NSHealthUpdateUsageDescription": "Kuova does not save anything to Health. It only reads the data you allow, to show it next to your lab results and your daily log.",
          "background": false
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2E7D5B",
          "sounds": [
            "./assets/sounds/kuova_campana.wav",
            "./assets/sounds/kuova_cuenco.wav",
            "./assets/sounds/kuova_toques.wav",
            "./assets/sounds/kuova_pitido.wav"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e88f66c2-4fae-44aa-a3b6-1812c06dcd15"
      }
    },
    "owner": "astoramor",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e88f66c2-4fae-44aa-a3b6-1812c06dcd15"
    },
    "locales": {
      "es": "./assets/locales/es.json"
    }
  }
}
