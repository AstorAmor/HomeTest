# Copiar a .env.local y rellenar. .env.local NO se sube a git.

# Supabase (publicas por diseño: van dentro de la app)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo para las rutas API locales (modo demo, sin Supabase).
# En Supabase, GEMINI_API_KEY es un secreto de las Edge Functions (supabase secrets set).
GEMINI_API_KEY=
